# Supabase Configuration (Client-side safe publishable key only)
# Never expose the Supabase service_role key in frontend environment variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Production Site URL
VITE_SITE_URL=https://juanet.cloud

# AI Studio runtime vars (optional)
GEMINI_API_KEY=
APP_URL=

